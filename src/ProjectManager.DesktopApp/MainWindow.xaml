<Window x:Class="ProjectManager.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Atlas" Height="900" Width="1400"
        Icon="pack://application:,,,/Resources/atlas.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#141414">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#1a1a1a" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="16">
                        <Run x:Name="BrandPrimaryRun" Text="At" Foreground="#7c8db5" FontStyle="Italic" FontWeight="ExtraBold"/><Run x:Name="BrandAccentRun" Text="las" Foreground="#c9a96b" FontStyle="Italic" FontWeight="ExtraBold"/>
                    </TextBlock>
                    <TextBlock Text="The map of your projects" Foreground="#a1a1aa" FontSize="11"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="MinimizeButton" Content="&#x2500;" Width="40" Height="40"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Width="40" Height="40"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Content="&#x2715;" Width="40" Height="40"
                            Style="{StaticResource ChromeCloseButtonStyle}"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#141414">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="40">
                    <Run x:Name="LoadingPrimaryRun" Text="At" Foreground="#7c8db5" FontStyle="Italic" FontWeight="ExtraBold"/><Run x:Name="LoadingAccentRun" Text="las" Foreground="#c9a96b" FontStyle="Italic" FontWeight="ExtraBold"/>
                </TextBlock>
                <TextBlock Text="The map of your projects" Foreground="#a1a1aa" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Segoe UI"/>

                <!-- Spinner: golden arc rotating over a faint blue ring -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Ellipse Width="48" Height="48" Stroke="#27314a" StrokeThickness="4"/>
                    <Ellipse Width="48" Height="48" Stroke="#c9a96b" StrokeThickness="4"
                             StrokeDashArray="9.5 28" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360" Duration="0:0:1.1"
                                            RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="StatusText" Text="서버를 시작하고 있습니다"
                           Foreground="#9ca3af" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
