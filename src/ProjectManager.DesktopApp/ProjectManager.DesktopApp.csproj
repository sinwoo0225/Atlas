<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinRT(Windows.Media.Control SMTC) 사용을 위해 Windows SDK TFM 지정 — 위젯 음악 제어. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 위젯 창은 WinForms Form 으로 호스팅 — Form.Opacity 가 WebView2 콘텐츠까지 반투명 처리(WPF 창은 불가). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProjectManager.DesktopApp</RootNamespace>
    <AssemblyName>Atlas</AssemblyName>
    <ApplicationIcon>Resources\atlas.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- WinForms 활성화로 추가되는 전역 using 이 WPF 의 MessageBox/OpenFileDialog 와 충돌 → 전역 사용 해제.
       WinForms 타입이 필요한 WidgetForm.cs 는 파일 내 명시적 using 으로 처리. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\atlas.ico" Condition="Exists('Resources\atlas.ico')" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectManager.AppHost\ProjectManager.AppHost.csproj" />
  </ItemGroup>

  <Target Name="PublishFrontend" AfterTargets="Publish">
    <Message Text="Building React frontend..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\frontend" />
    <ItemGroup>
      <FrontendDist Include="$(MSBuildThisFileDirectory)..\..\frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDist)"
          DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Text="Frontend build copied to $(PublishDir)wwwroot." Importance="high" />
  </Target>
</Project>
